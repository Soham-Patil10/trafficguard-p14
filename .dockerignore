# Keep the Docker build context small and reproducible.

.git
.gitattributes
**/__pycache__
**/*.pyc

# Node / build artifacts (frontend is rebuilt inside the image)
node_modules
frontend/node_modules
frontend/dist

# Large dataset and raw data — not needed at runtime
data/Data
data/raw

# Notebooks and their checkpoints
**/*.ipynb
**/.ipynb_checkpoints

# Spare/large model checkpoints — only best.pt + poisoned.pt are served
model/checkpoints/best_old_backup.pt
model/checkpoints/clean_baseline.pt
model/checkpoints/poisoned_*.pt
model/best.pt
best.pt.zip

# Training/experiment outputs
attacks/adversarial_images
attacks/models
model/models
scratchpad
